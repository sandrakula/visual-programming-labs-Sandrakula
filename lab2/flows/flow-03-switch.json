    "name": "Сумма квадратов",
    "func": "const input = Number(msg.payload);\nlet total = 0;\nconst squares = [];\n\nfor (let i = 1; i <= input; i++) {\n    const square = i * i;\n    squares.push(square);\n    total += square;\n}\n\nlet category;\nif (total >= 50) {\n    category = \"не меньше 50\";\n} else {\n    category = \"меньше 50\";\n}\n\nconst details = {\n    student: \"Sandrakula\",\n    input: input,\n    squares: squares,\n    total: total,\n    category: category\n};\n\nmsg.calculation = details;\nmsg.payload = total;\nreturn msg;",
