      "id": "f07-webhook",
      "name": "POST Note",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [160, 300],
      "webhookId": "sandrakula-notes-post"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nif (!body.title || !body.text) {\n  throw new Error('Fields title and text are required');\n}\nconst id = `${Date.now()}`;\nconst note = { id, title: body.title, text: body.text, author: 'Sandrakula', createdAt: new Date().toISOString() };\nreturn [{ json: { id, redisKey: `notes:sandrakula:${id}`, note } }];"
      },
      "id": "f07-code",
      "name": "Validate and Build Note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "operation": "set",
        "key": "={{ $json.redisKey }}",
        "value": "={{ JSON.stringify($json.note) }}",
        "keyType": "string",
        "expire": false
      },
      "id": "f07-redis",
      "name": "Redis Save Note",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [660, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, message: 'Note stored in Redis', student: 'Sandrakula' } }}",
        "options": { "responseCode": 201 }
      },
      "id": "f07-response",
      "name": "201 Created",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [920, 300]
    }
  ],
